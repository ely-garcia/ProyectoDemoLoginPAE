<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.demologin.controller.UsuarioModalController"
      alignment="CENTER"
      spacing="12"
      prefWidth="420"
      prefHeight="520">
    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>
    <Label text="Usuario registrado"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <ImageView fx:id="imageFoto"
               fitWidth="140"
               fitHeight="140"
               preserveRatio="true"/>
    <Label fx:id="lblNombre"/>
    <Label fx:id="lblApellido"/>
    <Label fx:id="lblCorreo"/>
    <Label fx:id="lblUsuario"/>
    <Label fx:id="lblRutaFoto" wrapText="true"/>
    <Button text="Cerrar" onAction="#mostrarFoto"/>
</VBox>
